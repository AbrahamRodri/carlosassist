<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070E1F" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="mapbox-token" content={Application.get_env(:carlosassist, :mapbox)[:public_key]} />
    <.live_title default="CarlosAssist" suffix={assigns[:page_title] && " · CarlosAssist"}>
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/images/favicon-32.png"} />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <link
      rel="preload"
      href={~p"/fonts/eb-garamond-latin.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/cormorant-garamond-latin.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to the main part of the page</a>
    <Layouts.site_header current_scope={assigns[:current_scope]} />
    {@inner_content}
    <Layouts.site_footer current_scope={assigns[:current_scope]} />
  </body>
</html>
