<div class="min-h-screen bg-base-200/50">
  <!-- Header -->
  <div class="bg-base-100 shadow-sm border-b">
    <div class="max-w-6xl mx-auto p-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold text-base-content mb-2">Rider Dashboard</h1>
          <p class="text-base-content/70">Request and manage your transportation with volunteers</p>
        </div>
        
        <button 
          :if={!@show_form} 
          phx-click="show_form" 
          class="btn btn-primary btn-modern px-6 py-3 flex items-center gap-2"
        >
          <.icon name="hero-plus" class="w-5 h-5" />
          Request New Ride
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto p-6">
    <!-- New Ride Form -->
    <.new_ride_form 
      :if={@show_form} 
      form={@form} 
      wizard_step={@wizard_step} 
      wizard_data={@wizard_data} 
    />
    
    <!-- Rides List -->
    <div :if={!@show_form} class="bg-base-100 rounded-xl shadow-sm border p-6">
      <div class="flex items-center gap-2 mb-6">
        <.icon name="hero-truck" class="w-5 h-5 text-primary" />
        <h2 class="text-lg font-semibold">My Rides</h2>
        <div class="ml-auto text-sm text-base-content/60">
          {length(@rides)} total rides
        </div>
      </div>
      
      <.rides_list rides={@rides} volunteer_indices={@volunteer_indices} />
    </div>
  </div>
  
  <!-- Ride Details Modal -->
  <.ride_details_modal 
    :if={@show_ride_details && @selected_ride}
    ride={@selected_ride} 
    volunteer_indices={@volunteer_indices}
  />
</div>
