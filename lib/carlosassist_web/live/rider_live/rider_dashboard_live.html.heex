<div class="min-h-screen bg-base-200">
  <div class="container mx-auto px-6 py-8 max-w-7xl">
    <!-- Header Section -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-semibold text-base-content mb-2">My Rides</h1>
          <p class="text-base-content/70">Request and manage your transportation</p>
        </div>
        
        <button 
          :if={!@show_form} 
          phx-click="show_form" 
          class="btn btn-primary btn-modern px-6 py-3 flex items-center gap-2"
        >
          <.icon name="hero-plus" class="w-5 h-5" />
          Request New Ride
        </button>
      </div>
    </div>
    
    <!-- New Ride Form -->
    <.new_ride_form 
      :if={@show_form} 
      form={@form} 
      wizard_step={@wizard_step} 
      wizard_data={@wizard_data} 
    />
    
    <!-- Rides List -->
    <.rides_list rides={@rides} />
  </div>
</div>
