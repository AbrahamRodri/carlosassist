<div class="flex-1 bg-base-200/50">
  <!-- Greeting -->
  <div class="bg-base-100 border-b-2 border-base-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-3xl text-base-content mb-1">
            Hello, {Carlosassist.Accounts.User.first_name(@current_scope.user)}
          </h1>
          <p class="text-lg text-base-content/75">Where do you need to go?</p>
        </div>

        <button :if={!@show_form} phx-click="show_form" class="btn btn-primary btn-xl w-full sm:w-auto px-8">
          <.icon name="hero-plus" class="w-6 h-6" /> Ask for a ride
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6">
    <!-- New Ride Form -->
    <.new_ride_form
      :if={@show_form}
      form={@form}
      wizard_step={@wizard_step}
      wizard_data={@wizard_data}
    />

    <!-- Rides List -->
    <div :if={!@show_form}>
      <.rides_list rides={@rides} volunteer_indices={@volunteer_indices} />
    </div>
  </div>

  <!-- Ride Details Modal -->
  <.ride_details_modal
    :if={@show_ride_details && @selected_ride}
    ride={@selected_ride}
    volunteer_indices={@volunteer_indices}
  />
</div>
