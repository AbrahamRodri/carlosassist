<Layouts.app flash={@flash} current_scope={@current_scope} width="text">
  <.header :if={!@show_form} kicker="Rider">
    My rides
    <:subtitle>Ask for a ride, then choose who drives you.</:subtitle>
    <:actions>
      <button phx-click="show_form" class="btn btn-gold btn-lg w-full md:w-auto">
        <.icon name="hero-plus" class="size-6" /> Ask for a ride
      </button>
    </:actions>
  </.header>

  <.new_ride_form
    :if={@show_form}
    form={@form}
    wizard_step={@wizard_step}
    wizard_data={@wizard_data}
  />

  <.rides_list :if={!@show_form} rides={@rides} />

  <.ride_details_modal
    :if={@show_ride_details && @selected_ride}
    ride={@selected_ride}
    volunteer_indices={@volunteer_indices}
  />
</Layouts.app>
