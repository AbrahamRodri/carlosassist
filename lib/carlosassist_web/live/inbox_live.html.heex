<Layouts.app flash={@flash} current_scope={@current_scope} width="text">
  <.header kicker="Messages">
    Your conversations
    <:subtitle>Write to your rider or your driver about the pickup.</:subtitle>
  </.header>

  <CarlosassistWeb.UI.MessageComponents.conversations_list
    conversations={@conversations}
    current_user={@current_user}
  />
</Layouts.app>
