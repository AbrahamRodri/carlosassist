<div class="flex-1 bg-base-200/50">
  <!-- Greeting -->
  <div class="bg-base-100 border-b-2 border-base-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6">
      <h1 class="text-3xl text-base-content mb-1">
        Thank you for driving, {Carlosassist.Accounts.User.first_name(@current_scope.user)}
      </h1>
      <p class="text-lg text-base-content/75">
        Neighbors who need a ride are listed below. Help when it fits your week.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 space-y-8 lg:grid lg:grid-cols-3 lg:gap-8 lg:space-y-0">
    <!-- Available Rides - Main Content -->
    <div class="lg:col-span-2 lg:order-1">
      <div class="parish-card p-5 sm:p-6">
        <div class="flex items-center gap-2 mb-6">
          <.icon name="hero-hand-raised" class="w-6 h-6 text-primary" />
          <h2 class="text-2xl text-base-content">Neighbors who need a ride</h2>
        </div>

        <CarlosassistWeb.UI.VolunteerComponents.single_ride_browser
          rides={@pending_rides}
          current_index={@current_ride_index}
        />
      </div>
    </div>

    <!-- My Offers - Sidebar -->
    <div class="lg:col-span-1 lg:order-2">
      <div class="parish-card p-5 sm:p-6">
        <div class="flex items-center gap-2 mb-6">
          <.icon name="hero-clipboard-document-list" class="w-6 h-6 text-primary" />
          <h2 class="text-2xl text-base-content">My offers</h2>
        </div>

        <CarlosassistWeb.UI.VolunteerComponents.volunteer_requests_section requests={@my_requests} />
      </div>
    </div>
  </div>

  <!-- Request Modal -->
  <CarlosassistWeb.UI.VolunteerComponents.volunteer_request_modal
    :if={@show_request_modal}
    selected_ride={@selected_ride}
    request_message={@request_message}
    rides={@pending_rides}
  />

  <!-- Request Details Modal -->
  <CarlosassistWeb.UI.VolunteerComponents.volunteer_request_details_modal
    :if={@show_request_details && @detailed_request}
    request={@detailed_request}
  />
</div>
