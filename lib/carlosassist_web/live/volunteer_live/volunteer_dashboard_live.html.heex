<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header kicker="Volunteer driver">
    Ride requests
    <:subtitle>Offer to drive the rides that fit your day.</:subtitle>
  </.header>

  <div class="grid gap-10 lg:grid-cols-5 lg:gap-8">
    <section class="lg:order-2 lg:col-span-2" aria-labelledby="my-offers">
      <h2 id="my-offers" class="section-title mb-4">
        My offers <span :if={@my_requests != []} class="muted">({length(@my_requests)})</span>
      </h2>
      <CarlosassistWeb.UI.VolunteerComponents.volunteer_requests_section requests={@my_requests} />
    </section>

    <section
      class="lg:order-1 lg:col-span-3"
      aria-labelledby="open-rides"
      phx-window-keydown="navigate_rides"
    >
      <h2 id="open-rides" class="section-title mb-4">Rides that need a driver</h2>
      <CarlosassistWeb.UI.VolunteerComponents.single_ride_browser
        rides={@pending_rides}
        current_index={@current_ride_index}
      />
    </section>
  </div>

  <CarlosassistWeb.UI.VolunteerComponents.volunteer_request_modal
    :if={@show_request_modal}
    selected_ride={@selected_ride}
    request_message={@request_message}
    rides={@pending_rides}
  />

  <CarlosassistWeb.UI.VolunteerComponents.volunteer_request_details_modal
    :if={@show_request_details && @detailed_request}
    request={@detailed_request}
  />
</Layouts.app>
