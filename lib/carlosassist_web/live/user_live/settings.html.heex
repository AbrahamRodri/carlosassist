<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-2xl">
    <div class="text-center mb-8">
      <h1 class="text-3xl sm:text-4xl text-base-content mb-2">My Account</h1>
      <span class="gold-rule mx-auto my-4"></span>
      <p class="text-lg text-base-content/75">
        Your name, photo, and contact details — as your neighbors see them.
      </p>
    </div>

    <!-- Who you are -->
    <section class="parish-card p-6 sm:p-8 mb-6">
      <div class="flex items-center gap-4 mb-6">
        <.avatar src={@current_scope.user.profile_pic_location} alt="Your photo" size="xl" />
        <div>
          <p class="font-display text-2xl text-base-content">
            {Carlosassist.Accounts.User.display_name(@current_scope.user)}
          </p>
          <p class="text-base text-base-content/70 capitalize">
            {if @current_scope.user.role == "volunteer",
              do: "Volunteer driver",
              else: "Rider"}
          </p>
        </div>
      </div>

      <.form for={@name_form} id="name_form" phx-submit="update_name" phx-change="validate_name">
        <.input
          field={@name_form[:name]}
          type="text"
          label="Your name"
          placeholder="For example: Mary Johnson"
          autocomplete="name"
          required
        />
        <.button variant="primary" phx-disable-with="Saving...">Save my name</.button>
      </.form>

      <div class="divider"></div>

      <h3 class="text-lg font-bold text-base-content mb-1">Your photo</h3>
      <p class="text-base text-base-content/70 mb-3">
        A friendly photo helps neighbors recognize you.
      </p>
      <.form
        for={@profile_pic_form}
        id="profile_pic_form"
        phx-submit="update_profile_pic"
        phx-change="validate_profile_pic"
        multipart={true}
      >
        <.live_file_input
          upload={@uploads.profile_pic}
          class="file-input file-input-bordered w-full"
        />

        <%= for entry <- @uploads.profile_pic.entries do %>
          <progress
            :if={entry.progress > 0}
            class="progress progress-primary w-full mt-2"
            value={entry.progress}
            max="100"
          >
          </progress>
        <% end %>
        <div class="mt-3">
          <.button variant="primary" phx-disable-with="Uploading...">
            Save my photo
          </.button>
        </div>
      </.form>
    </section>

    <!-- Volunteer car details -->
    <section :if={@current_scope.user.role == "volunteer"} class="parish-card p-6 sm:p-8 mb-6">
      <h2 class="text-2xl text-base-content mb-1">My car</h2>
      <p class="text-base text-base-content/70 mb-4">
        Riders see this so they know what car to look for.
      </p>
      <.form
        for={@volunteer_form}
        id="volunteer_form"
        phx-submit="update_volunteer_info"
        phx-change="validate_volunteer_info"
      >
        <.input
          field={@volunteer_form[:volunteer_car]}
          type="text"
          label="Car color, make, and model"
          placeholder="For example: Red Toyota Camry"
          required
        />
        <.input
          field={@volunteer_form[:volunteer_license_plate]}
          type="text"
          label="License plate"
          required
        />
        <.input
          field={@volunteer_form[:volunteer_bio]}
          type="textarea"
          label="A little about you"
          placeholder="For example: Retired teacher, parishioner for 20 years. Happy to help with walkers and groceries."
        />
        <.button variant="primary" phx-disable-with="Saving...">
          Save my car details
        </.button>
      </.form>
    </section>

    <!-- Contact details -->
    <section class="parish-card p-6 sm:p-8 mb-6">
      <h2 class="text-2xl text-base-content mb-4">How we reach you</h2>

      <.form for={@email_form} id="email_form" phx-submit="update_email" phx-change="validate_email">
        <.input
          field={@email_form[:email]}
          type="email"
          label="Email address"
          autocomplete="username"
          required
        />
        <.button variant="primary" phx-disable-with="Saving...">Change my email</.button>
        <p class="text-base text-base-content/70 mt-2">
          We'll send a link to the new address to make sure it's yours.
        </p>
      </.form>

      <div class="divider"></div>

      <.form for={@phone_form} id="phone_form" phx-submit="update_phone" phx-change="validate_phone">
        <.input
          field={@phone_form[:phone]}
          type="tel"
          label="Phone number"
          autocomplete="tel"
          required
        />
        <.button variant="primary" phx-disable-with="Saving...">Change my phone number</.button>
      </.form>
    </section>

    <!-- Password -->
    <section class="parish-card p-6 sm:p-8 mb-6">
      <h2 class="text-2xl text-base-content mb-1">Password</h2>
      <p class="text-base text-base-content/70 mb-4">
        Optional — you can always sign in with an emailed link instead.
      </p>
      <.form
        for={@password_form}
        id="password_form"
        action={~p"/users/update-password"}
        method="post"
        phx-change="validate_password"
        phx-submit="update_password"
        phx-trigger-action={@trigger_submit}
      >
        <input
          name={@password_form[:email].name}
          type="hidden"
          id="hidden_user_email"
          autocomplete="username"
          value={@current_email}
        />
        <input
          name={@password_form[:phone].name}
          type="hidden"
          id="hidden_user_phone"
          autocomplete="phone"
          value={@current_phone}
        />
        <.input
          field={@password_form[:password]}
          type="password"
          label="New password"
          autocomplete="new-password"
          required
        />
        <.input
          field={@password_form[:password_confirmation]}
          type="password"
          label="Type the new password again"
          autocomplete="new-password"
        />
        <.button variant="primary" phx-disable-with="Saving...">
          Save my password
        </.button>
      </.form>
    </section>

    <!-- Display -->
    <section class="parish-card p-6 sm:p-8">
      <h2 class="text-2xl text-base-content mb-1">Screen appearance</h2>
      <p class="text-base text-base-content/70 mb-4">
        Choose lighter or darker colors — whichever is easier on your eyes.
      </p>
      <Layouts.theme_toggle />
    </section>
  </div>
</Layouts.app>
