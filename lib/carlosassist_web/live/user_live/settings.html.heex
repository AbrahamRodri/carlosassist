<Layouts.app flash={@flash} current_scope={@current_scope} width="text">
  <.header kicker="Your account">
    Settings
    <:subtitle>Change your photo, email, phone number or password.</:subtitle>
  </.header>

  <div class="grid gap-6">
    <section class="sheet" aria-labelledby="settings-account">
      <h2 id="settings-account" class="section-title mb-5">Your details</h2>
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
        <.avatar src={@current_scope.user.profile_pic_location} alt="Your photo" size="2xl" />
        <div class="data-grid flex-1">
          <.datum label="Email" class="data-span">{@current_scope.user.email}</.datum>
          <.datum label="Phone">{@current_scope.user.phone}</.datum>
          <.datum label="You are a">
            {if @current_scope.user.role == "volunteer", do: "Volunteer driver", else: "Rider"}
          </.datum>
        </div>
      </div>
    </section>

    <section class="sheet" aria-labelledby="settings-photo">
      <h2 id="settings-photo" class="section-title mb-1">Your photo</h2>
      <p class="muted small mb-5">
        A photo helps the other person know who to look for. JPG or PNG.
      </p>
      <.form
        for={@profile_pic_form}
        id="profile_pic_form"
        phx-submit="update_profile_pic"
        phx-change="validate_profile_pic"
        multipart={true}
      >
        <div class="field">
          <label for={@uploads.profile_pic.ref} class="field-label">Choose a photo</label>
          <.live_file_input upload={@uploads.profile_pic} class="field-file" />
          <%= for entry <- @uploads.profile_pic.entries do %>
            <div :if={entry.progress > 0} class="upload-progress">
              <span style={"width: #{entry.progress}%"}></span>
            </div>
          <% end %>
        </div>
        <.button phx-disable-with="Uploading...">Update Profile Picture</.button>
      </.form>
    </section>

    <section
      :if={@current_scope.user.role == "volunteer"}
      class="sheet"
      aria-labelledby="settings-volunteer"
    >
      <h2 id="settings-volunteer" class="section-title mb-1">You and your car</h2>
      <p class="muted small mb-5">Riders see this when you offer to drive them.</p>
      <.form
        for={@volunteer_form}
        id="volunteer_form"
        phx-submit="update_volunteer_info"
        phx-change="validate_volunteer_info"
      >
        <div class="grid gap-x-6 md:grid-cols-2">
          <.input
            field={@volunteer_form[:volunteer_license_plate]}
            type="text"
            label="License plate number"
            required
          />
          <.input
            field={@volunteer_form[:volunteer_car]}
            type="text"
            label="Car make, model and color"
            required
          />

          <div class="md:col-span-2">
            <.input
              field={@volunteer_form[:volunteer_bio]}
              type="textarea"
              label="A few words about you"
              placeholder="Anything you would like riders to know about you."
            />
          </div>
        </div>
        <.button phx-disable-with="Updating...">Update Volunteer Info</.button>
      </.form>
    </section>

    <section class="sheet" aria-labelledby="settings-email">
      <h2 id="settings-email" class="section-title mb-1">Email</h2>
      <p class="muted small mb-5">
        We send a link to the new address. The change happens when you open that link.
      </p>
      <.form
        for={@email_form}
        id="email_form"
        phx-submit="update_email"
        phx-change="validate_email"
      >
        <.input
          field={@email_form[:email]}
          type="email"
          label="Email"
          autocomplete="username"
          required
        />
        <.button phx-disable-with="Changing...">Change Email</.button>
      </.form>
    </section>

    <section class="sheet" aria-labelledby="settings-phone">
      <h2 id="settings-phone" class="section-title mb-5">Phone number</h2>
      <.form
        for={@phone_form}
        id="phone_form"
        phx-submit="update_phone"
        phx-change="validate_phone"
      >
        <.input
          field={@phone_form[:phone]}
          type="tel"
          label="Phone number"
          autocomplete="tel"
          required
        />
        <.button phx-disable-with="Changing...">Change Phone Number</.button>
      </.form>
    </section>

    <section class="sheet" aria-labelledby="settings-password">
      <h2 id="settings-password" class="section-title mb-1">Password</h2>
      <p class="muted small mb-5">At least 12 characters.</p>
      <.form
        for={@password_form}
        id="password_form"
        action={~p"/users/update-password"}
        method="post"
        phx-change="validate_password"
        phx-submit="update_password"
        phx-trigger-action={@trigger_submit}
      >
        <input
          name={@password_form[:email].name}
          type="hidden"
          id="hidden_user_email"
          autocomplete="username"
          value={@current_email}
        />
        <input
          name={@password_form[:phone].name}
          type="hidden"
          id="hidden_user_phone"
          autocomplete="tel"
          value={@current_phone}
        />
        <.input
          field={@password_form[:password]}
          type="password"
          label="New password"
          autocomplete="new-password"
          required
        />
        <.input
          field={@password_form[:password_confirmation]}
          type="password"
          label="Confirm new password"
          autocomplete="new-password"
        />
        <.button phx-disable-with="Saving...">
          Save Password
        </.button>
      </.form>
    </section>
  </div>
</Layouts.app>
