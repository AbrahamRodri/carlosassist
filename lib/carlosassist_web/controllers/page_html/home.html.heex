<Layouts.flash_group flash={@flash} />

<!-- Hero -->
<section class="bg-base-100">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-14 pb-16 text-center">
    <div class="inline-flex items-center justify-center mb-8">
      <div class="arch-top-soft bg-base-200 border-2 border-base-300 px-10 pt-10 pb-6">
        <Layouts.brand_mark class="w-20 h-24 mx-auto" />
      </div>
    </div>

    <h1 class="text-4xl sm:text-5xl text-base-content mb-3 text-balance">
      Need a ride to Mass, the doctor, or the store?
    </h1>
    <span class="gold-rule mx-auto my-6"></span>
    <p class="text-xl sm:text-2xl text-base-content/80 max-w-2xl mx-auto leading-relaxed mb-10 text-balance">
      Neighbors from your parish community are glad to drive you — free of charge,
      door to door, with a friendly face.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <%= if @current_scope do %>
        <.link
          navigate={
            if @current_scope.user.role == "volunteer",
              do: ~p"/dashboard/volunteer",
              else: ~p"/dashboard/rider"
          }
          class="btn btn-primary btn-xl px-10 w-full sm:w-auto"
        >
          {if @current_scope.user.role == "volunteer",
            do: "See who needs a ride",
            else: "Go to my rides"}
          <.icon name="hero-arrow-right" class="w-6 h-6" />
        </.link>
      <% else %>
        <.link href={~p"/users/register?role=rider"} class="btn btn-primary btn-xl px-10 w-full sm:w-auto">
          I need a ride
        </.link>
        <.link href={~p"/users/register?role=volunteer"} class="btn btn-outline btn-xl px-10 w-full sm:w-auto">
          I'd like to drive
        </.link>
      <% end %>
    </div>
    <p :if={!@current_scope} class="mt-6 text-lg text-base-content/70">
      Already a member?
      <.link href={~p"/users/log-in"} class="link font-bold text-primary">Sign in here</.link>
    </p>
  </div>
</section>

<!-- How it works -->
<section class="bg-base-200 border-y-2 border-base-300">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl text-base-content mb-3">
        How it works
      </h2>
      <p class="text-xl text-base-content/75">
        Three simple steps. We walk with you the whole way.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="arch-top-soft bg-base-100 border-2 border-base-300 px-8 pt-12 pb-8 text-center">
        <div class="w-16 h-16 rounded-full bg-primary text-primary-content font-display text-3xl flex items-center justify-center mx-auto mb-5">
          1
        </div>
        <h3 class="text-2xl text-base-content mb-3">Ask for a ride</h3>
        <p class="text-lg text-base-content/75 leading-relaxed">
          Tell us where you're going and when. It takes about two minutes,
          one question at a time.
        </p>
      </div>

      <div class="arch-top-soft bg-base-100 border-2 border-base-300 px-8 pt-12 pb-8 text-center">
        <div class="w-16 h-16 rounded-full bg-primary text-primary-content font-display text-3xl flex items-center justify-center mx-auto mb-5">
          2
        </div>
        <h3 class="text-2xl text-base-content mb-3">Choose your driver</h3>
        <p class="text-lg text-base-content/75 leading-relaxed">
          Volunteers offer to help. You see their name, photo, and car —
          and you decide who drives you.
        </p>
      </div>

      <div class="arch-top-soft bg-base-100 border-2 border-base-300 px-8 pt-12 pb-8 text-center">
        <div class="w-16 h-16 rounded-full bg-primary text-primary-content font-display text-3xl flex items-center justify-center mx-auto mb-5">
          3
        </div>
        <h3 class="text-2xl text-base-content mb-3">Ride together</h3>
        <p class="text-lg text-base-content/75 leading-relaxed">
          Message your driver to settle the details, then enjoy the trip
          with a neighbor from your community.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Reassurance -->
<section class="bg-base-100">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl text-base-content mb-3">
        You are in good hands
      </h2>
      <span class="gold-rule mx-auto"></span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div class="px-4">
        <.icon name="hero-hand-raised" class="w-12 h-12 text-accent mx-auto mb-4" />
        <h3 class="text-xl font-bold text-base-content mb-2">You always choose</h3>
        <p class="text-lg text-base-content/75 leading-relaxed">
          No one is ever assigned to you. You pick your driver, and you can
          change your mind at any time.
        </p>
      </div>
      <div class="px-4">
        <.icon name="hero-lock-closed" class="w-12 h-12 text-accent mx-auto mb-4" />
        <h3 class="text-xl font-bold text-base-content mb-2">Your address stays private</h3>
        <p class="text-lg text-base-content/75 leading-relaxed">
          Volunteers only see your general area. Your exact address is shared
          only with the driver you accept.
        </p>
      </div>
      <div class="px-4">
        <.icon name="hero-heart" class="w-12 h-12 text-accent mx-auto mb-4" />
        <h3 class="text-xl font-bold text-base-content mb-2">Neighbors, not strangers</h3>
        <p class="text-lg text-base-content/75 leading-relaxed">
          Every driver is a volunteer from the community who gives their time
          freely. No money ever changes hands.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Volunteer invitation -->
<section class="bg-base-200 border-t-2 border-base-300">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16 text-center">
    <h2 class="text-3xl sm:text-4xl text-base-content mb-4">
      Have a car and an hour to spare?
    </h2>
    <p class="text-xl text-base-content/75 leading-relaxed mb-8 text-balance">
      A short drive means the world to a neighbor who can no longer drive themselves.
      Browse ride requests and help when it fits your week — no commitment required.
    </p>
    <.link
      :if={!@current_scope}
      href={~p"/users/register?role=volunteer"}
      class="btn btn-primary btn-xl px-10"
    >
      Become a volunteer driver
    </.link>
  </div>
</section>
