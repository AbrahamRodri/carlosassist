<Layouts.flash_group flash={@flash} />

<!-- Hero Section -->
<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0); background-size: 20px 20px;"
    >
    </div>
  </div>
  
<!-- Main Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center">
      <!-- Logo -->
      <div class="mb-8">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-primary/10 rounded-2xl mb-6">
          <span class="text-4xl font-bold text-primary">C</span>
        </div>
      </div>
      
<!-- Headline -->
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-base-content mb-6">
        <span class="text-primary">Carlos</span>Assist
      </h1>
      
<!-- Subheadline -->
      <p class="text-xl sm:text-2xl text-base-content/80 mb-12 max-w-3xl mx-auto leading-relaxed">
        Empowering communities through seamless ride coordination and volunteer support
      </p>
      
<!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
        <%= if @current_scope do %>
          <.link
            href={"/dashboard/#{@current_scope.user.role}"}
            class="btn btn-primary btn-lg px-8"
          >
            Go to Dashboard <.icon name="hero-arrow-right" class="w-5 h-5 ml-2" />
          </.link>
        <% else %>
          <.link href={~p"/users/register"} class="btn btn-primary btn-lg px-8">
            Get Started <.icon name="hero-arrow-right" class="w-5 h-5 ml-2" />
          </.link>
        <% end %>
        <.link href="#features" class="btn btn-outline btn-lg px-8">
          Learn More
        </.link>
      </div>
    </div>
  </div>
</section>

<!-- Features Section -->
<section id="features" class="py-20 bg-base-200/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-base-content mb-4">
        Built for Community Impact
      </h2>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        Connecting those who need transportation with volunteers who care
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Feature 1 -->
      <div class="modern-card bg-base-100/50 p-8 rounded-2xl text-center group hover:scale-105 transition-all duration-300">
        <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary/20 transition-colors">
          <.icon name="hero-users" class="w-8 h-8 text-primary" />
        </div>
        <h3 class="text-xl font-semibold text-base-content mb-4">Community Driven</h3>
        <p class="text-base-content/70">
          Built by the community, for the community. Every ride makes a difference.
        </p>
      </div>
      
<!-- Feature 2 -->
      <div class="modern-card bg-base-100/50 p-8 rounded-2xl text-center group hover:scale-105 transition-all duration-300">
        <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary/20 transition-colors">
          <.icon name="hero-map-pin" class="w-8 h-8 text-primary" />
        </div>
        <h3 class="text-xl font-semibold text-base-content mb-4">Smart Matching</h3>
        <p class="text-base-content/70">
          Intelligent algorithms connect riders with the perfect volunteer driver.
        </p>
      </div>
      
<!-- Feature 3 -->
      <div class="modern-card bg-base-100/50 p-8 rounded-2xl text-center group hover:scale-105 transition-all duration-300">
        <div class="w-16 h-16 bg-primary/10 rounded-xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary/20 transition-colors">
          <.icon name="hero-shield-check" class="w-8 h-8 text-primary" />
        </div>
        <h3 class="text-xl font-semibold text-base-content mb-4">Safe & Secure</h3>
        <p class="text-base-content/70">
          Verified volunteers and secure ride tracking for peace of mind.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Stats Section -->
<section class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="text-3xl sm:text-4xl font-bold text-primary mb-2">1,000+</div>
        <div class="text-base-content/70">Rides Completed</div>
      </div>
      <div>
        <div class="text-3xl sm:text-4xl font-bold text-primary mb-2">500+</div>
        <div class="text-base-content/70">Active Volunteers</div>
      </div>
      <div>
        <div class="text-3xl sm:text-4xl font-bold text-primary mb-2">50+</div>
        <div class="text-base-content/70">Communities Served</div>
      </div>
      <div>
        <div class="text-3xl sm:text-4xl font-bold text-primary mb-2">98%</div>
        <div class="text-base-content/70">Satisfaction Rate</div>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="py-12 bg-base-200/30 border-t border-base-300/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center">
      <div class="flex items-center space-x-3 mb-4 md:mb-0">
        <div class="w-8 h-8 bg-primary rounded-xl flex items-center justify-center">
          <span class="text-primary-content font-bold text-sm">C</span>
        </div>
        <span class="text-xl font-semibold text-base-content">CarlosAssist</span>
      </div>

      <div class="flex items-center space-x-6">
        <.link href="#" class="text-base-content/60 hover:text-base-content transition-colors">
          Privacy Policy
        </.link>
        <.link href="#" class="text-base-content/60 hover:text-base-content transition-colors">
          Terms of Service
        </.link>
        <.link href="#" class="text-base-content/60 hover:text-base-content transition-colors">
          Contact
        </.link>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-base-300/50 text-center">
      <p class="text-base-content/60">
        © 2024 CarlosAssist. Made with ❤️ for communities that care.
      </p>
    </div>
  </div>
</footer>
