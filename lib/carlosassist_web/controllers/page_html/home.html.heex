<main id="main" class="site-main">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker mb-3">Parish ride help</p>
        <h1 class="display">A ride to Mass, the doctor or the store</h1>
        <.divider class="divider-start" />
        <p class="lead max-w-xl">
          CarlosAssist connects people who need a ride with parish volunteers
          who are glad to drive them. There is no charge.
        </p>

        <%= if @current_scope do %>
          <div class="btn-row mt-8">
            <.link
              :if={@current_scope.user.role == "volunteer"}
              href={~p"/dashboard/volunteer"}
              class="btn btn-gold btn-lg"
            >
              See ride requests <.icon name="hero-arrow-right" class="size-6" />
            </.link>
            <.link
              :if={@current_scope.user.role != "volunteer"}
              href={~p"/dashboard/rider"}
              class="btn btn-gold btn-lg"
            >
              Go to my rides <.icon name="hero-arrow-right" class="size-6" />
            </.link>
            <.link href={~p"/dashboard/inbox"} class="btn btn-outline btn-lg">
              Messages
            </.link>
          </div>
        <% else %>
          <div class="btn-row mt-8">
            <.link href={~p"/users/register?role=rider"} class="btn btn-gold btn-lg">
              I need a ride
            </.link>
            <.link href={~p"/users/register?role=volunteer"} class="btn btn-outline btn-lg">
              I want to drive
            </.link>
          </div>
          <p class="muted mt-5">
            Already have an account? <.link href={~p"/users/log-in"} class="link">Log in</.link>
          </p>
        <% end %>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="arch">
          <img src={~p"/images/carlosassist-mark.webp"} alt="" width="360" height="360" />
        </div>
      </div>
    </div>
  </section>

  <section class="band band-deep" aria-labelledby="how-heading">
    <div class="wrap">
      <p class="kicker text-center mb-2">Three steps</p>
      <h2 id="how-heading" class="section-title text-center">How it works</h2>
      <.divider />

      <ol class="step-list">
        <li class="hairline-card">
          <span class="numeral" aria-hidden="true">1</span>
          <h3 class="card-title">Ask for a ride</h3>
          <p class="muted mt-2">Enter where you need to go, and the day and time.</p>
        </li>
        <li class="hairline-card">
          <span class="numeral" aria-hidden="true">2</span>
          <h3 class="card-title">Choose your driver</h3>
          <p class="muted mt-2">
            Volunteers offer to take you. You see each one's photo, car and
            message, and you choose who drives you.
          </p>
        </li>
        <li class="hairline-card">
          <span class="numeral" aria-hidden="true">3</span>
          <h3 class="card-title">Agree on the pickup</h3>
          <p class="muted mt-2">
            Send your driver a message here to settle the time and the place.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="who-heading">
    <div class="wrap">
      <p class="kicker text-center mb-2">Who it is for</p>
      <h2 id="who-heading" class="section-title text-center">Riders and drivers</h2>
      <.divider />

      <div class="card-pair">
        <article class="sheet">
          <p class="kicker mb-1">Riders</p>
          <h3 class="card-title">If you need a ride</h3>
          <ul class="check-list">
            <li>
              <.icon name="hero-check" />
              <span>Ask from a phone or a computer, on any day.</span>
            </li>
            <li>
              <.icon name="hero-check" />
              <span>You decide who drives you.</span>
            </li>
            <li>
              <.icon name="hero-check" />
              <span>You can write to your driver before the ride.</span>
            </li>
          </ul>
          <.link
            :if={!@current_scope}
            href={~p"/users/register?role=rider"}
            class="btn btn-gold btn-block"
          >
            I need a ride
          </.link>
        </article>

        <article class="sheet">
          <p class="kicker mb-1">Drivers</p>
          <h3 class="card-title">If you can drive</h3>
          <ul class="check-list">
            <li>
              <.icon name="hero-check" />
              <span>See the rides people are asking for.</span>
            </li>
            <li>
              <.icon name="hero-check" />
              <span>Offer to help with the ones that fit your day.</span>
            </li>
            <li>
              <.icon name="hero-check" />
              <span>Share your photo and your car, so riders know who is coming.</span>
            </li>
          </ul>
          <.link
            :if={!@current_scope}
            href={~p"/users/register?role=volunteer"}
            class="btn btn-outline btn-block"
          >
            I want to drive
          </.link>
        </article>
      </div>
    </div>
  </section>

  <section :if={!@current_scope} class="band band-deep" aria-labelledby="signin-heading">
    <div class="wrap flex flex-col items-center gap-6 text-center">
      <h2 id="signin-heading" class="section-title">Already have an account?</h2>
      <.link href={~p"/users/log-in"} class="btn btn-outline btn-lg">
        Log in
      </.link>
    </div>
  </section>
</main>

<Layouts.flash_group flash={@flash} />
